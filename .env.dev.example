# SkySend dev environment, the template of .env.dev.
# Copy it to .env.dev, which git ignores, and change values there. pnpm dev reads .env.dev.
# The setup scripts create it for a new checkout or worktree. Keep this file current when a
# variable is added.

# Network
BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
#PORT=3000
RATE_LIMIT_MAX=600
#FILE_UPLOAD_CONCURRENT_CHUNKS=6
#FILE_UPLOAD_SPEED_LIMIT=100MB
#FILE_UPLOAD_WS=true

# File upload limits
FILE_MAX_SIZE=10GB
FILE_MAX_FILES_PER_UPLOAD=32
FILE_EXPIRE_OPTIONS_SEC=300,3600,3434
FILE_DEFAULT_EXPIRE_SEC=3600
FILE_DOWNLOAD_OPTIONS=10,50,1000
FILE_DEFAULT_DOWNLOAD=50
FILE_UPLOAD_QUOTA_BYTES=100GB

# Note upload limits
NOTE_MAX_SIZE=100KB
NOTE_EXPIRE_OPTIONS_SEC=300,3600,360000
NOTE_DEFAULT_EXPIRE_SEC=3600
NOTE_VIEW_OPTIONS=0,1,100,10000
NOTE_DEFAULT_VIEWS=100

# File request limits
#FILE_REQUEST_EXPIRE_OPTIONS_SEC=86400,259200,604800
#FILE_REQUEST_DEFAULT_EXPIRE_SEC=259200
#FILE_REQUEST_UPLOAD_OPTIONS=1,2,3,5,10,20,50,100
#FILE_REQUEST_DEFAULT_UPLOADS=10
#FILE_REQUEST_MAX_SIZE=1GB
#FILE_REQUEST_RETENTION_SEC=604800
#FILE_REQUEST_DOWNLOAD_OPTIONS=1,2,3,5,10,20
#FILE_REQUEST_DEFAULT_DOWNLOADS=5
#FILE_REQUEST_DAILY_LIMIT=100

# Password protection
#FORCE_FILE_PASSWORD=false
#FORCE_NOTE_PASSWORD=false
#FORCE_REQUEST_PASSWORD=false
#FORCE_FILE_PASSWORD=true
#FORCE_NOTE_PASSWORD=true
#FORCE_REQUEST_PASSWORD=true
#PASSWORD_MAX_ATTEMPTS=10
#PASSWORD_LOCKOUT_MS=900000

# Appearance
#DEFAULT_THEME=midnight
#DEFAULT_COLOR_SCHEME=light
#DEFAULT_TAB=password
#ENABLED_SERVICES=file,note,request
#CUSTOM_TITLE=SkySend Dev
#CUSTOM_COLOR=d63c4a
#CUSTOM_LOGO=
#CUSTOM_OG_IMAGE=
#CUSTOM_OG_IMAGE_STYLE=banner

# Footer / Links
CUSTOM_PRIVACY=https://skysend.app
CUSTOM_LEGAL=https://skysend.app
CUSTOM_LINK_URL=https://skysend.app
CUSTOM_LINK_NAME=SkySend
CUSTOM_REPORT_URL=https://skysend.app/report

# S3 Storage
#STORAGE_BACKEND=s3
#S3_BUCKET=
#S3_REGION=
#S3_ENDPOINT=
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# OIDC/SSO Authentication (uncomment to enable)
#------------------------------------------------------------------------------
#OIDC_PROVIDER=pocketid
#OIDC_ISSUER="https://auth.example.com"
#OIDC_CLIENT_ID="your-client-id"
#OIDC_CLIENT_SECRET="your-client-secret"
#OIDC_SESSION_SECRET="" # Generate by: openssl rand -base64 48
#OIDC_PROTECT_FILES=true
#OIDC_PROTECT_NOTES=true
#OIDC_PROTECT_REQUESTS=true

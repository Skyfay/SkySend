{
  "name": "skysend",
  "version": "2.12.0",
  "private": true,
  "type": "module",
  "description": "Minimalist, end-to-end encrypted, self-hostable file sharing service",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "pnpm --parallel --filter=!@skysend/instances-worker --filter=!@skysend/report-worker dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "test:coverage": "pnpm --recursive --filter=@skysend/server --filter=@skysend/web --filter=@skysend/crypto --filter=@skysend/client test:coverage",
    "lint": "eslint . && pnpm --filter @skysend/website lint",
    "lint:fix": "eslint . --fix && pnpm --filter @skysend/website lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @skysend/crypto --filter @skysend/server build && pnpm --recursive typecheck",
    "validate": "bash scripts/validate.sh",
    "version:sync": "bash scripts/sync-version.sh --sync-only",
    "version:bump": "bash scripts/sync-version.sh",
    "changelog:next": "bash scripts/sync-version.sh --changelog-init",
    "client:build": "pnpm --filter @skysend/crypto build && pnpm --filter @skysend/client build",
    "client:run": "tsx apps/client/src/index.ts",
    "client:compile": "pnpm client:build && pnpm --filter @skysend/client build:compile",
    "update:check": "bash scripts/check-updates.sh"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "fast-xml-parser": ">=5.7.2",
      "postcss": ">=8.5.25",
      "@esbuild-kit/core-utils>esbuild": ">=0.25.0",
      "vitepress>vite": ">=6.4.3 <7",
      "ws": ">=8.21.0",
      "miniflare>undici": ">=7.28.0",
      "tsx>esbuild": ">=0.28.1",
      "wrangler>esbuild": ">=0.28.1",
      "@babel/core": ">=7.29.6",
      "sharp": ">=0.35.3",
      "brace-expansion": ">=5.0.9",
      "minimatch@3>brace-expansion": "^1.1.18"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}

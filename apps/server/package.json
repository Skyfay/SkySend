{
  "name": "@skysend/server",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./db/schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./lib/config": {
      "types": "./dist/lib/config.d.ts",
      "import": "./dist/lib/config.js"
    },
    "./lib/cleanup": {
      "types": "./dist/lib/cleanup.d.ts",
      "import": "./dist/lib/cleanup.js"
    },
    "./storage/filesystem": {
      "types": "./dist/storage/filesystem.d.ts",
      "import": "./dist/storage/filesystem.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.dev src/index.ts",
    "build": "tsc && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-storage": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@hono/node-server": "^2.1.3",
    "@hono/node-ws": "^1.3.1",
    "@skysend/crypto": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}

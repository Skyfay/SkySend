  },
  "dependencies": {
    "@skysend/crypto": "workspace:*",
    "@skysend/note-format": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0"
  }
